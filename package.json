{
  "name": "productos-antiestres-backend",
  "version": "1.0.0",
  "main": "main.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "seed:products": "ts-node scripts/seedProducts.ts",
    "create:admin": "ts-node scripts/createAdmin.ts",
    "prisma": "prisma",
    "test": "cross-env JWT_SECRET=testsecret jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "prisma": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).[tj]s"
    ],
    "moduleDirectories": [
      "node_modules",
      "./"
    ]
  }
}
